meta {
  name: Web assets — root (index.html)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains "text/html"
  res.body: contains "<title>Linkomat</title>"
}

docs {
  GET / — serves the embedded SPA shell (index.html). No
  Cache-Control: no-store, private header is set on web assets so
  the PWA service worker and HTTP cache can do their job.
}

settings {
  encodeUrl: false
}