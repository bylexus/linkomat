meta {
  name: Login (bad password)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{badPassword}}"
  }
}

assert {
  res.status: eq 401
  res.body.type: contains invalid-credentials
  res.body.title: isString
  res.body.status: eq 401
}

docs {
  Login with the wrong password — expect 401 invalid-credentials. The
  server never reveals whether the username or the password was the
  bad one (same error for both cases).

  Each call here counts against the in-memory rate-limit bucket for
  (IP, username). Running this 5+ times within a minute will trip the
  rate limiter (see login-rate-limited.bru).
}