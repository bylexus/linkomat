meta {
  name: Refresh (JSON body — CLI flow)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  bru.cookies.delete('linkomat_refresh');
}

body:json {
  {
    "refresh_token": "{{lastRefreshToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("lastAccessToken", res.body.access_token);
    bru.setEnvVar("lastRefreshToken", res.body.refresh_token);
  }
}

assert {
  res.status: eq 200
  res.body.access_token: isString
  res.body.refresh_token: neq {{bogusRefreshToken}}
  res.body.username: eq {{username}}
}

docs {
  POST /auth/refresh with the refresh token in JSON body — this is the
  CLI flow (the CLI never sends cookies).

  Requires env var `lastRefreshToken` to be set. Run login.bru (or
  refresh-cookie.bru) immediately before this so the post-response
  script populates it. The script also captures the rotated
  refresh_token after this call, so chained refresh-body calls keep
  working as long as you run them in order.
}